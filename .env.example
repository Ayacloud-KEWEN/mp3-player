# 音频主目录：其下每个子目录就是一个播放列表（音频与同名 .srt/.vtt/.lrc 字幕放在一起）
MEDIA_DIR=/home/pi/audio
PORT=10020
HOST=0.0.0.0

# 仅在电脑上开启：在设置里显示"生成字幕 / 翻译"工具（需先运行 tools/setup）
# ENABLE_TOOLS=1
# 允许局域网其他设备使用这些工具（默认只允许本机）
# TOOLS_ALLOW_LAN=1

# 日常句子的法语声音（Piper）：fr_FR-tom-medium（默认，男声）/ fr_FR-gilles-low（男声）
# fr_FR-upmc-medium 需配合 PIPER_SPEAKER=1（pierre，男声）
# PIPER_VOICE=fr_FR-tom-medium
# PIPER_SPEAKER=1

# 双语阅读用 DeepSeek 识别图片与翻译（仅电脑版）；模型留空则自动选择
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_VISION_MODEL=
# BOOKS_DIR=books
